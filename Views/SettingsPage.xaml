<Page
    x:Class="NewWinampClassic.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="8,6,8,12">
        <StackPanel Spacing="10" Background="#050D05" HorizontalAlignment="Stretch">
            <TextBlock Text="WINAMP SETTINGS" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#22E222" />

            <!--  Music Library Card  -->
            <Border
                Padding="8,8"
                Background="#081408"
                BorderBrush="#142C14"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#22E222"
                        Text="MUSIC LIBRARY FOLDERS" />

                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="#00B800"
                        Text="Folders to scan and index:" />

                    <ListView
                        x:Name="FoldersListView"
                        MaxHeight="120"
                        Padding="2"
                        Background="#000000"
                        BorderBrush="#142C14"
                        BorderThickness="1"
                        CornerRadius="2"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="2,3" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="#00E800"
                                        Text="{Binding}"
                                        TextWrapping="Wrap"
                                        ToolTipService.ToolTip="{Binding}" />
                                    <Button
                                        Grid.Column="1"
                                        Width="18"
                                        Height="18"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveFolder_Click"
                                        ToolTipService.ToolTip="Remove folder">
                                        <FontIcon
                                            FontSize="9"
                                            Foreground="#FF4444"
                                            Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Style="{StaticResource WaMetalButton}"
                            Height="24"
                            Padding="8,0"
                            Click="AddFolder_Click">
                            <TextBlock Text="+ ADD FOLDER" FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                        </Button>
                        <ToggleSwitch
                            x:Name="AutoScanToggle"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="#00E800"
                            Header=""
                            OffContent="Auto-scan off"
                            OnContent="Auto-scan on"
                            Toggled="AutoScanToggle_Toggled" />
                    </Grid>

                    <Button
                        x:Name="ScanButton"
                        Style="{StaticResource WaMetalButton}"
                        Height="24"
                        HorizontalAlignment="Stretch"
                        Click="Scan_Click">
                        <TextBlock Text="SCAN LIBRARY NOW" FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
                    </Button>

                    <ProgressBar
                        x:Name="ScanProgress"
                        Height="3"
                        IsIndeterminate="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ScanStatusText"
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="#00B800"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!--  Appearance  -->
            <Border
                Padding="8,8"
                Background="#081408"
                BorderBrush="#142C14"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#22E222" Text="THEME" />
                    <ComboBox
                        x:Name="ThemeCombo"
                        Grid.Column="1"
                        Height="24"
                        MinWidth="90"
                        HorizontalAlignment="Right"
                        FontFamily="Consolas"
                        FontSize="10"
                        SelectedIndex="0"
                        SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!--  About  -->
            <Border
                Padding="8,8"
                Background="#081408"
                BorderBrush="#142C14"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="AppNameText"
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#22E222"
                        Text="New Winamp Classic" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="#00B800"
                        Text="Retro Classic Music Player for Windows" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="9"
                        Foreground="#008800"
                        Text="Version 1.0.0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
