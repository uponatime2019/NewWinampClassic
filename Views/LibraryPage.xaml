<Page
    x:Class="NewWinampClassic.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="8,6,8,6" RowSpacing="6" Background="#050D05">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="WINAMP LIBRARY" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#22E222" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource WaMetalButton}" Height="22" Padding="6,0" Click="Refresh_Click">
                <TextBlock Text="REFRESH" FontFamily="Consolas" FontSize="10" FontWeight="Bold" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" Height="24" FontFamily="Consolas" FontSize="11" PlaceholderText="Search songs..." QueryIcon="Find" QuerySubmitted="SearchBox_QuerySubmitted" />
            <ComboBox x:Name="SortCombo" Grid.Column="1" Height="24" FontFamily="Consolas" FontSize="10" MinWidth="80" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged">
                <ComboBoxItem Content="Title" />
                <ComboBoxItem Content="Artist" />
                <ComboBoxItem Content="Album" />
                <ComboBoxItem Content="Duration" />
                <ComboBoxItem Content="Date Added" />
                <ComboBoxItem Content="Play Count" />
            </ComboBox>
            <ToggleButton x:Name="SortDirectionBtn" Grid.Column="2" Style="{StaticResource WaToggleButton}" Height="24" Width="26" Padding="0" Click="SortDirection_Click" ToolTipService.ToolTip="Sort order">
                <FontIcon Glyph="&#xE8CB;" FontSize="11" />
            </ToggleButton>
        </Grid>

        <ListView x:Name="SongListView" Grid.Row="2" Background="#000000" SelectionMode="Single" IsItemClickEnabled="True" ItemContainerStyle="{StaticResource WaPlaylistItemStyle}" />

        <TextBlock x:Name="FooterText" Grid.Row="3" FontFamily="Consolas" FontSize="10" Foreground="#00B800" Margin="2,2,0,0" />
    </Grid>
</Page>
