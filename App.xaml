<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="NewWinampClassic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:NewWinampClassic.Helpers"
    xmlns:local="using:NewWinampClassic">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:ArtworkPathConverter x:Key="ArtworkConv" />
            <helpers:FavoriteIconConverter x:Key="FavIconConv" />
            <helpers:FavoriteColorConverter x:Key="FavColorConv" />

            <!-- ============ Classic Winamp palette ============ -->
            <Color x:Key="WaBevelLightColor">#8A8A92</Color>
            <Color x:Key="WaBevelDarkColor">#1C1C22</Color>
            <Color x:Key="WaLcdGreenColor">#2BE32B</Color>
            <Color x:Key="WaLcdBgColor">#081408</Color>
            <Color x:Key="WaTextDimColor">#A8B2A8</Color>
            <Color x:Key="WaLitGreenColor">#00FF41</Color>

            <SolidColorBrush x:Key="WaBevelLightBrush" Color="#8A8A92" />
            <SolidColorBrush x:Key="WaBevelDarkBrush" Color="#1C1C22" />
            <SolidColorBrush x:Key="WaLcdGreenBrush" Color="#2BE32B" />
            <SolidColorBrush x:Key="WaLcdBgBrush" Color="#081408" />
            <SolidColorBrush x:Key="WaTextDimBrush" Color="#A8B2A8" />
            <SolidColorBrush x:Key="WaLitGreenBrush" Color="#00FF41" />
            <SolidColorBrush x:Key="WaTrackTextBrush" Color="#00E800" />
            <SolidColorBrush x:Key="WaTrackSelectedBrush" Color="#1E2FA8" />

            <LinearGradientBrush x:Key="WaBodyBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#5E5E66" Offset="0" />
                <GradientStop Color="#4A4A52" Offset="0.45" />
                <GradientStop Color="#3A3A42" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WaTitleBarBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#9A9AA4" Offset="0" />
                <GradientStop Color="#6E6E78" Offset="0.5" />
                <GradientStop Color="#4E4E58" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WaButtonFaceBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#7C7C86" Offset="0" />
                <GradientStop Color="#585862" Offset="0.5" />
                <GradientStop Color="#44444E" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WaButtonFacePressedBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3C3C44" Offset="0" />
                <GradientStop Color="#50505A" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WaPlHeaderBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00D000" Offset="0" />
                <GradientStop Color="#007800" Offset="1" />
            </LinearGradientBrush>

            <!-- ============ Styles ============ -->
            <Style x:Key="WaTinyText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Tahoma" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#C4CCC4" />
            </Style>

            <Style x:Key="WaTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Tahoma" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#101014" />
            </Style>

            <Style x:Key="WaMetalButton" TargetType="Button">
                <Setter Property="FontFamily" Value="Tahoma" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#E4E8E4" />
                <Setter Property="Background" Value="{StaticResource WaButtonFaceBrush}" />
                <Setter Property="BorderBrush" Value="#181820" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Bd.Opacity" Value="1.0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Bd.Background" Value="{StaticResource WaButtonFacePressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Bd.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="2" Opacity="0.92">
                                    <Border BorderBrush="#98989F" BorderThickness="1,1,0,0" CornerRadius="2">
                                        <Border BorderBrush="#24242B" BorderThickness="0,0,1,1" CornerRadius="2">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                        </Border>
                                    </Border>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WaToggleButton" TargetType="ToggleButton">
                <Setter Property="FontFamily" Value="Tahoma" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#8E9A8E" />
                <Setter Property="Background" Value="{StaticResource WaButtonFaceBrush}" />
                <Setter Property="BorderBrush" Value="#181820" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Bd.Opacity" Value="1.0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Bd.Background" Value="{StaticResource WaButtonFacePressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Bd.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Foreground" Value="{StaticResource WaLitGreenBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="2" Opacity="0.92">
                                    <Border BorderBrush="#98989F" BorderThickness="1,1,0,0" CornerRadius="2">
                                        <Border BorderBrush="#24242B" BorderThickness="0,0,1,1" CornerRadius="2">
                                            <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                        </Border>
                                    </Border>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Playlist ListViewItem: dark rows, classic blue selection band -->
            <Style x:Key="WaPlaylistItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="RootBd" Background="#00010001">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBd.Background" Value="#0E2E0E" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="RootBd.Background" Value="{StaticResource WaTrackSelectedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBd.Background" Value="{StaticResource WaTrackSelectedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBd.Background" Value="#16248A" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
